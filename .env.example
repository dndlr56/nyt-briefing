# Google AI Studio에서 발급받은 Gemini API 키
GEMINI_API_KEY=your_gemini_api_key_here

# 텔레그램 @BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 브리핑을 받을 텔레그램 채팅 ID (숫자)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# The Guardian Open Platform 무료 API 키 (https://open-platform.theguardian.com/access/)
GUARDIAN_API_KEY=your_guardian_api_key_here

# 선택: 사용할 Gemini 모델 (기본값: gemini-4-hydrogen)
# GEMINI_MODEL=gemini-4-hydrogen

# 선택: 오디오 브리핑용 Gemini TTS 모델 및 목소리
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore

# ── Deep Dive Knowledge Briefing (선택 설정) ──
# DEEP_CURATOR_MODEL=gemini-3.5-flash-lite
# DEEP_NOTE_MODEL=gemini-3.8-flash
# DEEP_SCRIPT_MODEL=gemini-4-hydrogen

# Google Drive 3단 아카이빙용 개인 OAuth2 시크릿 (scripts/get_drive_refresh_token.py 참고)
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
